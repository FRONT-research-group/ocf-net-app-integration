# CAPIF Core
CAPIF_HOST=<CAPIF_HOST>
CAPIF_HTTPS_PORT=443

# CAPIF Register
REGISTER_HOST=<REGISTER_HOST>
CAPIF_REGISTER_PORT=8084

# Provider
CAPIF_PROVIDER_USERNAME=<PROVIDER_USERNAME>
CAPIF_PROVIDER_PASSWORD=<PROVIDER_PASSWORD>

# Invoker
CAPIF_INVOKER_USERNAME=<INVOKER_USERNAME>
CAPIF_INVOKER_PASSWORD=<INVOKER_PASSWORD>

# NEF
NEF_HOST=<NEF_HOST>
NEF_PORT=8000

# TLS
CAPIF_TLS_VERIFY=true
